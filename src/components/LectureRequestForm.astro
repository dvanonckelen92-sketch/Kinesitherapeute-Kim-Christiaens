---
import type { NlDictionary } from '../i18n/types';

interface Props {
  t: NlDictionary;
}

const { t } = Astro.props;
const f = t.lectures.form;
const formName = 'lezing-nl';
---

<form
  class="contact-form card"
  name={formName}
  method="POST"
  data-netlify="true"
  netlify-honeypot="bot-field"
  action="/contact/bedankt/"
>
  <h2>{f.title}</h2>
  <input type="hidden" name="form-name" value={formName} />
  <p class="honeypot-field">
    <label>
      {f.honeypot}
      <input name="bot-field" tabindex="-1" autocomplete="off" />
    </label>
  </p>

  <div class="form-field">
    <label for={`${formName}-org`}>{f.orgName}</label>
    <input type="text" id={`${formName}-org`} name="organisatie" minlength="2" required />
  </div>

  <div class="form-field">
    <label for={`${formName}-contact`}>{f.contactPerson}</label>
    <input type="text" id={`${formName}-contact`} name="contactpersoon" autocomplete="name" minlength="2" required />
  </div>

  <div class="form-field">
    <label for={`${formName}-email`}>{t.contact.form.email}</label>
    <input type="email" id={`${formName}-email`} name="email" autocomplete="email" required />
  </div>

  <div class="form-field">
    <label for={`${formName}-audience`}>{f.audience}</label>
    <input type="text" id={`${formName}-audience`} name="doelgroep" minlength="2" />
  </div>

  <div class="form-field">
    <label for={`${formName}-attendees`}>{f.attendees}</label>
    <input type="number" id={`${formName}-attendees`} name="aantal_deelnemers" min="1" step="1" inputmode="numeric" />
  </div>

  <div class="form-field">
    <label for={`${formName}-theme`}>{f.theme}</label>
    <input type="text" id={`${formName}-theme`} name="thema" minlength="2" required />
  </div>

  <div class="form-field">
    <label for={`${formName}-date`}>{f.preferredDate}</label>
    <input type="date" id={`${formName}-date`} name="voorkeursdatum" min={new Date().toISOString().slice(0, 10)} />
  </div>

  <div class="form-field">
    <label for={`${formName}-location`}>{f.location}</label>
    <input type="text" id={`${formName}-location`} name="locatie" />
  </div>

  <div class="form-field">
    <label for={`${formName}-extra`}>{f.extra}</label>
    <textarea id={`${formName}-extra`} name="toelichting" rows="4"></textarea>
  </div>

  <button type="submit" class="btn btn-primary">{f.submit}</button>
</form>

<style>
  .contact-form {
    display: grid;
    gap: 1.1rem;
  }

  .contact-form h2 {
    margin: 0;
    font-size: 1.2rem;
  }

  .honeypot-field {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .form-field {
    display: grid;
    gap: 0.4rem;
  }

  .form-field label {
    font-weight: 600;
    font-size: 0.95rem;
  }

  .form-field input,
  .form-field textarea {
    font: inherit;
    color: var(--color-ink);
    background: #fff;
    border: 2px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 0.65em 0.85em;
    resize: vertical;
  }

  .form-field input:focus-visible,
  .form-field textarea:focus-visible {
    outline: 3px solid var(--color-primary-dark);
    outline-offset: 1px;
    border-color: var(--color-primary-dark);
  }

  .contact-form .btn {
    justify-self: start;
  }
</style>
