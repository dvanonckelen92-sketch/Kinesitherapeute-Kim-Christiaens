---
interface Props {
  icon: 'perinatal' | 'pelvic' | 'manual';
  class?: string;
}
const { icon, class: className } = Astro.props;
---

<svg
  class={className}
  width="48"
  height="48"
  viewBox="0 0 48 48"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
  focusable="false"
>
  <circle cx="24" cy="24" r="23" fill="var(--color-bg-alt-2)" />
  {
    icon === 'perinatal' && (
      <>
        <path
          d="M24 33c-6.5-4.1-11.5-8.9-11.5-14.6C12.5 14 16 10.8 20 10.8c1.9 0 3.7.9 4.6 2.5 1-1.6 2.7-2.5 4.6-2.5 4 0 7.5 3.2 7.5 7.6 0 5.7-5 10.5-11.5 14.6Z"
          fill="var(--color-primary)"
        />
        <circle cx="24" cy="18.5" r="2.6" fill="var(--color-gold-strong)" />
      </>
    )
  }
  {
    icon === 'pelvic' && (
      <>
        <path
          d="M24 12a7 7 0 0 1 7 7v3.2a7 7 0 0 1-2.4 5.3l-1 .9a4 4 0 0 0-1.4 3v.9a2.2 2.2 0 0 1-4.4 0v-.9a4 4 0 0 0-1.4-3l-1-.9A7 7 0 0 1 17 22.2V19a7 7 0 0 1 7-7Z"
          fill="var(--color-primary)"
        />
        <circle cx="20.5" cy="19.5" r="1.6" fill="var(--color-gold-strong)" />
        <circle cx="27.5" cy="19.5" r="1.6" fill="var(--color-gold-strong)" />
      </>
    )
  }
  {
    icon === 'manual' && (
      <>
        <path
          d="M15 15h4.4v6.4H15zM28.6 15H33v6.4h-4.4zM15 26.6h4.4V33H15zM28.6 26.6H33V33h-4.4z"
          fill="var(--color-primary)"
        />
        <rect x="19.4" y="22.4" width="9.2" height="3.2" rx="1.6" fill="var(--color-gold-strong)" />
        <path
          d="M19.4 17.2h9.2M19.4 30.8h9.2"
          stroke="var(--color-primary)"
          stroke-width="2.4"
          stroke-linecap="round"
        />
      </>
    )
  }
</svg>
