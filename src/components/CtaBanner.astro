---
interface Props {
  title: string;
  text: string;
  ctaLabel: string;
  ctaHref: string;
  phone: string;
  phoneHref: string;
}

const { title, text, ctaLabel, ctaHref, phone, phoneHref } = Astro.props;
---

<section class="cta-banner">
  <div class="container cta-inner">
    <div>
      <h2>{title}</h2>
      <p>{text}</p>
    </div>
    <div class="cta-actions">
      <a class="btn btn-gold" href={ctaHref}>{ctaLabel}</a>
      <a class="btn btn-secondary-inverse" href={phoneHref}>{phone}</a>
    </div>
  </div>
</section>

<style>
  .cta-banner {
    background: var(--color-primary);
    color: #fff;
    padding-block: clamp(2.5rem, 2rem + 2vw, 4rem);
  }

  .cta-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.75rem;
  }

  .cta-banner h2 {
    color: #fff;
    margin: 0 0 0.5rem;
  }

  .cta-banner p {
    margin: 0;
    max-width: 48ch;
    color: #f4e4e2;
  }

  .cta-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .btn-secondary-inverse {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.85em 1.6em;
    border-radius: var(--radius-full);
    border: 2px solid #fff;
    color: #fff;
    text-decoration: none;
    font-weight: 700;
  }

  .btn-secondary-inverse:hover {
    background: #fff;
    color: var(--color-primary-dark);
  }

  .cta-banner :focus-visible {
    outline: 3px solid #fff;
    outline-offset: 3px;
    box-shadow: 0 0 0 6px rgba(255, 255, 255, 0.35);
  }
</style>
