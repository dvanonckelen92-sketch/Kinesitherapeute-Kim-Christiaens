---
interface Props {
  eyebrow: string;
  title: string;
  intro?: string;
}

const { eyebrow, title, intro } = Astro.props;
---

<header class="page-intro">
  <div class="container">
    <p class="eyebrow">{eyebrow}</p>
    <h1>{title}</h1>
    {intro && <p class="intro-text">{intro}</p>}
  </div>
</header>

<style>
  .page-intro {
    background: linear-gradient(180deg, var(--color-bg-alt) 0%, #fff 100%);
    padding-block: clamp(2.5rem, 2rem + 2vw, 4.5rem) clamp(2rem, 1.5rem + 1.5vw, 3rem);
    border-bottom: 1px solid var(--color-border);
  }

  .intro-text {
    max-width: 62ch;
    font-size: 1.15rem;
    color: var(--color-ink-muted);
    margin-top: 1rem;
    margin-bottom: 0;
  }
</style>
