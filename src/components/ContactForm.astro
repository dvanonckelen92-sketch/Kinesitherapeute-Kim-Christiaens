---
import { getDictionary, route } from '../i18n';
import type { Locale } from '../consts';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getDictionary(locale);
const f = t.contact.form;
// Netlify herkent elk formulier aan zijn naam; NL en FR komen apart binnen.
const formName = `contact-${locale}`;
const actionHref = route('thanks', locale);
const privacyHref = route('privacy', locale);
---

<form
  class="contact-form card"
  name={formName}
  method="POST"
  data-netlify="true"
  netlify-honeypot="bot-field"
  action={actionHref}
>
  <h2>{t.contact.formTitle}</h2>
  <input type="hidden" name="form-name" value={formName} />
  <p class="honeypot-field">
    <label>
      {f.honeypot}
      <input name="bot-field" tabindex="-1" autocomplete="off" />
    </label>
  </p>

  <div class="form-field">
    <label for={`${formName}-name`}>{f.name}</label>
    <input type="text" id={`${formName}-name`} name="naam" autocomplete="name" minlength="2" required />
  </div>

  <div class="form-field">
    <label for={`${formName}-email`}>{f.email}</label>
    <input type="email" id={`${formName}-email`} name="email" autocomplete="email" required />
  </div>

  <div class="form-field">
    <label for={`${formName}-phone`}>{f.phone} <span class="text-muted">({f.phoneOptional})</span></label>
    <input
      type="tel"
      id={`${formName}-phone`}
      name="telefoon"
      autocomplete="tel"
      inputmode="numeric"
      pattern="\+?[0-9\s]{8,15}"
      title={f.phoneHint}
    />
  </div>

  <div class="form-field">
    <label for={`${formName}-subject`}>{f.subject}</label>
    <input type="text" id={`${formName}-subject`} name="onderwerp" minlength="2" />
  </div>

  <div class="form-field">
    <label for={`${formName}-message`}>{f.message}</label>
    <textarea id={`${formName}-message`} name="bericht" rows="5" minlength="10" required></textarea>
  </div>

  <fieldset class="form-field">
    <legend>{f.preferredContactLabel}</legend>
    <div class="radio-row">
      <label>
        <input type="radio" name="voorkeur_contact" value={f.preferredContactEmail} checked />
        {f.preferredContactEmail}
      </label>
      <label>
        <input type="radio" name="voorkeur_contact" value={f.preferredContactMessage} />
        {f.preferredContactMessage}
      </label>
      <label>
        <input type="radio" name="voorkeur_contact" value={f.preferredContactPhone} />
        {f.preferredContactPhone}
      </label>
    </div>
  </fieldset>

  <p class="consent-field text-muted">
    <label>
      <input type="checkbox" name="toestemming" required />
      <span>
        {f.consent} <a href={privacyHref}>{f.privacyLink}</a>.
      </span>
    </label>
  </p>

  <button type="submit" class="btn btn-primary">{f.submit}</button>
</form>

<style>
  .contact-form {
    display: grid;
    gap: 1.1rem;
  }

  .contact-form h2 {
    margin: 0;
    font-size: 1.2rem;
  }

  .honeypot-field {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .form-field {
    display: grid;
    gap: 0.4rem;
  }

  .form-field label {
    font-weight: 600;
    font-size: 0.95rem;
  }

  .form-field input,
  .form-field textarea {
    font: inherit;
    color: var(--color-ink);
    background: #fff;
    border: 2px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 0.65em 0.85em;
    resize: vertical;
  }

  .form-field input:focus-visible,
  .form-field textarea:focus-visible {
    outline: 3px solid var(--color-primary-dark);
    outline-offset: 1px;
    border-color: var(--color-primary-dark);
  }

  .contact-form .btn {
    justify-self: start;
  }

  fieldset.form-field {
    border: none;
    padding: 0;
    margin: 0;
  }

  fieldset.form-field legend {
    font-weight: 600;
    font-size: 0.95rem;
    padding: 0;
    margin-bottom: 0.4rem;
  }

  .radio-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.25rem;
  }

  .radio-row label {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    font-weight: 500;
    font-size: 0.95rem;
  }

  .radio-row input[type='radio'],
  .consent-field input[type='checkbox'] {
    accent-color: var(--color-primary);
  }

  .consent-field {
    font-size: 0.9rem;
    margin: 0;
  }

  .consent-field label {
    display: flex;
    align-items: flex-start;
    gap: 0.5em;
  }

  .consent-field input[type='checkbox'] {
    margin-top: 0.2em;
    flex-shrink: 0;
  }
</style>
