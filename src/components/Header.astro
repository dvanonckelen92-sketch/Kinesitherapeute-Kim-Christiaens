---
import type { Locale } from '../consts';
import type { UiDictionary } from '../i18n/types';

interface Props {
  locale: Locale;
  t: UiDictionary;
  currentPath: string;
}

const { locale, t, currentPath } = Astro.props;

const base = locale === 'nl' ? '' : '/fr';

type NavItem = { href: string; label: string; children?: { href: string; label: string }[] };

const navItems: NavItem[] =
  t.lang === 'nl'
    ? [
        { href: '/over-kim/', label: t.nav.about },
        {
          href: '/pelvic-health/',
          label: t.nav.pelvic,
          children: [
            { href: '/pelvic-health/', label: t.nav.pelvicHome },
            { href: '/pelvic-health-vrouwen/', label: t.nav.pelvicWomen },
            { href: '/pelvic-health-mannen/', label: t.nav.pelvicMen },
            { href: '/pelvic-health-kinderen/', label: t.nav.pelvicChildren },
          ],
        },
        { href: '/hormonen-en-levensfasen/', label: t.nav.hormones },
        { href: '/bewegen-en-sport/', label: t.nav.movement },
        { href: '/lezingen-en-workshops/', label: t.nav.lectures },
        { href: '/praktische-info/', label: t.nav.practical },
        { href: '/contact/', label: t.nav.contact },
      ]
    : [
        { href: '/fr/accompagnement-perinatal/', label: t.nav.perinatal },
        { href: '/fr/reeducation-perineale/', label: t.nav.pelvic },
        { href: '/fr/therapie-manuelle/', label: t.nav.manual },
        { href: '/fr/tarifs/', label: t.nav.rates },
        { href: '/fr/contact/', label: t.nav.contact },
      ];

function isActive(href: string) {
  return currentPath === href || (href !== '/' && href !== '/fr/' && currentPath.startsWith(href));
}
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href={base + '/'}>
      <img
        class="brand-mark"
        src="/logo-header.png"
        width="1655"
        height="288"
        alt="The Happy Floor"
        loading="eager"
        decoding="async"
      />
      <span class="brand-signature">
        <span class="brand-and">and more</span>
        <span class="brand-by">by Kim Christiaens</span>
      </span>
    </a>

    <button
      id="nav-toggle"
      class="nav-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="primary-nav"
    >
      <span class="visually-hidden nav-toggle-label">{t.nav.menu}</span>
      <span class="nav-toggle-icon" aria-hidden="true"></span>
    </button>

    <nav id="primary-nav" class="primary-nav" aria-label={t.nav.menu}>
      <ul>
        {
          navItems.map((item) =>
            item.children ? (
              <li class="has-dropdown">
                <details class="nav-dropdown">
                  <summary aria-current={isActive(item.href) ? 'page' : undefined}>
                    {item.label}
                    <svg class="dropdown-caret" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
                      <polyline points="4 6 8 10 12 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                  </summary>
                  <ul class="dropdown-panel">
                    {item.children.map((child) => (
                      <li>
                        <a href={child.href} aria-current={currentPath === child.href ? 'page' : undefined}>
                          {child.label}
                        </a>
                      </li>
                    ))}
                  </ul>
                </details>
              </li>
            ) : (
              <li>
                <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
                  {item.label}
                </a>
              </li>
            )
          )
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 40;
    background: #ffffff;
    border-bottom: 1px solid var(--color-border);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 0.7rem;
    max-width: 90rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    flex: none;
  }

  .brand-mark {
    height: 1.45rem;
    width: auto;
  }

  .brand-signature {
    display: flex;
    flex-direction: column;
    justify-content: center;
    line-height: 1.2;
    padding-top: 0.1rem;
    border-left: 1px solid var(--color-border);
    padding-left: 0.45rem;
  }

  .brand-and {
    font-family: var(--font-sans);
    font-size: 0.52rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    white-space: nowrap;
    color: var(--color-ink-muted);
  }

  .brand-by {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 0.7rem;
    white-space: nowrap;
    color: var(--color-ink);
  }

  .nav-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: var(--radius-md);
    border: 2px solid var(--color-border);
    background: #fff;
    cursor: pointer;
  }

  .nav-toggle-icon,
  .nav-toggle-icon::before,
  .nav-toggle-icon::after {
    display: block;
    width: 1.35rem;
    height: 2px;
    background: var(--color-ink);
    border-radius: 2px;
    position: relative;
    transition: transform 0.2s ease, opacity 0.2s ease;
  }

  .nav-toggle-icon::before {
    content: '';
    position: absolute;
    top: -0.4rem;
  }

  .nav-toggle-icon::after {
    content: '';
    position: absolute;
    top: 0.4rem;
  }

  .nav-toggle[aria-expanded='true'] .nav-toggle-icon {
    background: transparent;
  }

  .nav-toggle[aria-expanded='true'] .nav-toggle-icon::before {
    transform: translateY(0.4rem) rotate(45deg);
  }

  .nav-toggle[aria-expanded='true'] .nav-toggle-icon::after {
    transform: translateY(-0.4rem) rotate(-45deg);
  }

  .primary-nav {
    display: none;
  }

  .primary-nav.is-open {
    display: block;
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    background: #fff;
    border-bottom: 1px solid var(--color-border);
    box-shadow: var(--shadow-soft);
    padding: 1rem 1.5rem 1.5rem;
    max-height: calc(100vh - 100%);
    overflow-y: auto;
  }

  .primary-nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .primary-nav ul li {
    margin: 0;
  }

  .primary-nav a {
    display: block;
    padding: 0.7em 0.5em;
    color: var(--color-ink);
    text-decoration: none;
    font-weight: 600;
    border-radius: var(--radius-md);
    white-space: nowrap;
  }

  .primary-nav a:hover {
    background: var(--color-bg-alt);
  }

  .primary-nav a[aria-current='page'] {
    color: var(--color-primary);
    background: var(--color-bg-alt-2);
  }

  .nav-dropdown summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.4em;
    padding: 0.7em 0.5em;
    color: var(--color-ink);
    font-weight: 600;
    border-radius: var(--radius-md);
    cursor: pointer;
    list-style: none;
    white-space: nowrap;
  }

  .nav-dropdown summary::-webkit-details-marker {
    display: none;
  }

  .nav-dropdown summary:hover {
    background: var(--color-bg-alt);
  }

  .nav-dropdown summary[aria-current='page'] {
    color: var(--color-primary);
  }

  .dropdown-caret {
    width: 0.9em;
    height: 0.9em;
    flex: none;
    transition: transform 0.15s ease;
  }

  .nav-dropdown[open] .dropdown-caret {
    transform: rotate(180deg);
  }

  .dropdown-panel {
    list-style: none;
    margin: 0.25rem 0 0.5rem;
    padding-left: 1rem;
    display: grid;
    gap: 0.15rem;
    border-left: 2px solid var(--color-border);
  }

  .dropdown-panel a {
    font-weight: 500;
    font-size: 0.95em;
  }

  @media (min-width: 80em) {
    .nav-toggle {
      display: none;
    }

    .primary-nav {
      display: flex;
      align-items: center;
      gap: 1.25rem;
    }

    .primary-nav ul {
      flex-direction: row;
      align-items: center;
      gap: 0.05rem;
    }

    .primary-nav a,
    .nav-dropdown summary {
      padding: 0.5em 0.5em;
      font-size: 0.87rem;
    }

    .has-dropdown {
      position: relative;
    }

    .nav-dropdown[open] .dropdown-panel {
      position: absolute;
      top: 100%;
      left: 0;
      min-width: 14rem;
      background: #fff;
      border: 1px solid var(--color-border);
      border-radius: var(--radius-md);
      box-shadow: var(--shadow-soft);
      padding: 0.5rem;
      margin: 0.25rem 0 0;
      border-left: none;
    }

    .dropdown-panel a {
      border-radius: var(--radius-md);
    }
  }
</style>

<script>
  const toggle = document.getElementById('nav-toggle');
  const nav = document.getElementById('primary-nav');

  if (toggle && nav) {
    toggle.addEventListener('click', () => {
      const expanded = toggle.getAttribute('aria-expanded') === 'true';
      toggle.setAttribute('aria-expanded', String(!expanded));
      nav.classList.toggle('is-open', !expanded);
    });

    nav.addEventListener('keydown', (event) => {
      if (event instanceof KeyboardEvent && event.key === 'Escape') {
        toggle.setAttribute('aria-expanded', 'false');
        nav.classList.remove('is-open');
        toggle.focus();
      }
    });

    const mq = window.matchMedia('(min-width: 80em)');
    mq.addEventListener('change', (event) => {
      if (event.matches) {
        nav.classList.remove('is-open');
        toggle.setAttribute('aria-expanded', 'false');
      }
    });

    // Close an open dropdown when clicking outside of it (desktop).
    document.addEventListener('click', (event) => {
      const target = event.target as Node;
      nav.querySelectorAll('details.nav-dropdown[open]').forEach((details) => {
        if (!details.contains(target)) {
          details.removeAttribute('open');
        }
      });
    });
  }
</script>
