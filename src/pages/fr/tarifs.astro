---
import Layout from '../../layouts/Layout.astro';
import PageIntro from '../../components/PageIntro.astro';
import CtaBanner from '../../components/CtaBanner.astro';
import { getDictionary } from '../../i18n';
import { SITE } from '../../consts';

const t = getDictionary('fr');
const r = t.rates;
---

<Layout locale="fr" t={t} title={r.metaTitle} description={r.metaDescription} altHref="/tarieven/">
  <PageIntro eyebrow={t.nav.rates} title={r.title} intro={r.intro} />

  <section class="section">
    <div class="container">
      <div class="rates-card card">
        <dl>
          {
            r.items.map((item) => (
              <div class="rates-row">
                <dt>{item.label}</dt>
                <dd>{item.value}</dd>
              </div>
            ))
          }
        </dl>
        <p class="text-muted rates-note">{r.note}</p>
        <a class="btn btn-primary" href="/fr/contact/">{t.cta.contact}</a>
      </div>
    </div>
  </section>

  <CtaBanner
    title={t.home.ctaTitle}
    text={t.home.ctaText}
    ctaLabel={t.cta.contact}
    ctaHref="/fr/contact/"
    phone={SITE.phone}
    phoneHref={SITE.phoneHref}
  />
</Layout>

<style>
  .rates-card {
    max-width: 34rem;
  }

  .rates-card dl {
    margin: 0;
  }

  .rates-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    padding-block: 0.9rem;
    border-bottom: 1px solid var(--color-border);
  }

  .rates-row:last-of-type {
    border-bottom: none;
  }

  .rates-row dt {
    color: var(--color-ink-muted);
  }

  .rates-row dd {
    margin: 0;
    font-weight: 700;
    font-size: 1.15rem;
    color: var(--color-primary-dark);
  }

  .rates-note {
    margin-top: 1.5rem;
  }
</style>
