---
import Layout from '../../layouts/Layout.astro';
import PageIntro from '../../components/PageIntro.astro';
import ContactForm from '../../components/ContactForm.astro';
import { getDictionary } from '../../i18n';
import { SITE } from '../../consts';

const t = getDictionary('fr');
const c = t.contact;

const { lat, lon } = SITE.coords;
const bbox = `${lon - 0.008},${lat - 0.005},${lon + 0.008},${lat + 0.005}`;
const mapSrc = `https://www.openstreetmap.org/export/embed.html?bbox=${bbox}&layer=mapnik&marker=${lat},${lon}`;
const directionsHref = `https://www.google.com/maps/dir/?api=1&destination=${lat},${lon}`;
---

<Layout locale="fr" t={t} title={c.metaTitle} description={c.metaDescription} altHref="/contact/">
  <PageIntro eyebrow={t.nav.contact} title={c.title} intro={c.intro} />

  <section class="section">
    <div class="container contact-grid">
      <div class="contact-cards">
        <div class="card contact-card">
          <h2>{c.addressTitle}</h2>
          <p>{SITE.address.street}<br />{SITE.address.postal}</p>
          <a class="btn btn-secondary" href={directionsHref} rel="noopener">
            {c.mapTitle}
          </a>
        </div>
        <div class="card contact-card">
          <h2>{c.phoneTitle}</h2>
          <p><a href={SITE.phoneHref}>{SITE.phone}</a></p>
          <p class="text-muted">{c.formNote}</p>
        </div>
        <div class="card contact-card">
          <h2>{c.emailTitle}</h2>
          <p><a href={`mailto:${SITE.email}`}>{SITE.email}</a></p>
        </div>
      </div>

      <div class="map-wrap">
        <iframe
          title={c.mapTitle}
          src={mapSrc}
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
        ></iframe>
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container contact-form-wrap">
      <ContactForm t={t} formName="contact-fr" actionHref="/fr/contact/merci/" />
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2>{c.linksTitle}</h2>
      <ul class="links-list">
        {
          c.links.map((link) => (
            <li>
              <a href={link.href}>{link.label}</a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Layout>

<style>
  .contact-grid {
    display: grid;
    gap: 2rem;
  }

  @media (min-width: 62em) {
    .contact-grid {
      grid-template-columns: 0.9fr 1.1fr;
      align-items: stretch;
    }
  }

  .contact-cards {
    display: grid;
    gap: 1.25rem;
  }

  .contact-card h2 {
    margin-top: 0;
    font-size: 1.2rem;
  }

  .contact-card .btn {
    margin-top: 0.75rem;
  }

  .map-wrap {
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid var(--color-border);
    min-height: 20rem;
  }

  .map-wrap iframe {
    width: 100%;
    height: 100%;
    min-height: 20rem;
    border: 0;
  }

  .links-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.75rem;
    max-width: 40rem;
  }

  .links-list a {
    font-weight: 600;
  }

  .contact-form-wrap {
    max-width: 34rem;
  }
</style>
