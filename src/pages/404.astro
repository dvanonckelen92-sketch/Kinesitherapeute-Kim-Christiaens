---
import Layout from '../layouts/Layout.astro';
import { getDictionary } from '../i18n';

const t = getDictionary('nl');
---

<Layout locale="nl" t={t} title={`404 — ${t.notFound.title}`} description={t.notFound.text} altHref="/fr/">
  <section class="section not-found">
    <div class="container">
      <p class="eyebrow">404</p>
      <h1>{t.notFound.title}</h1>
      <p class="text-muted">{t.notFound.text}</p>
      <a class="btn btn-primary" href="/">{t.cta.backHome}</a>
    </div>
  </section>
</Layout>

<style>
  .not-found {
    text-align: center;
    padding-block: clamp(4rem, 3rem + 4vw, 7rem);
  }

  .not-found .eyebrow {
    justify-content: center;
  }

  .not-found .btn {
    margin-top: 1.5rem;
  }
</style>
