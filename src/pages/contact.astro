---
import Layout from '../layouts/Layout.astro';
import PageIntro from '../components/PageIntro.astro';
import ContactForm from '../components/ContactForm.astro';
import { getDictionary } from '../i18n';
import { SITE } from '../consts';

const t = getDictionary('nl');
const c = t.contact;

const { lat, lon } = SITE.coords;
const bbox = `${lon - 0.008},${lat - 0.005},${lon + 0.008},${lat + 0.005}`;
const mapSrc = `https://www.openstreetmap.org/export/embed.html?bbox=${bbox}&layer=mapnik&marker=${lat},${lon}`;
const directionsHref = `https://www.google.com/maps/dir/?api=1&destination=${lat},${lon}`;
---

<Layout
  locale="nl"
  t={t}
  title={c.metaTitle}
  description={c.metaDescription}
  altHref="/fr/contact/"
  breadcrumb={[{ label: t.nav.contact, href: '/contact/' }]}
>
  <PageIntro eyebrow={c.eyebrow} title={c.title} intro={c.intro} />

  <section class="section">
    <div class="container contact-grid">
      <div class="contact-cards">
        <div class="card contact-card contact-card-primary">
          <h2>{c.emailTitle}</h2>
          <p><a href={`mailto:${SITE.email}`}>{SITE.email}</a></p>
          <a class="btn btn-primary" href={`mailto:${SITE.email}`}>{t.cta.email}</a>
        </div>
        <div class="card contact-card">
          <h2>{c.addressTitle}</h2>
          <p>{SITE.address.street}<br />{SITE.address.postal}</p>
          <a class="btn btn-secondary" href={directionsHref} rel="noopener">
            {c.mapTitle}
          </a>
        </div>
        <div class="contact-card-minor">
          <h2>{c.phoneTitle}</h2>
          <p><a href={SITE.phoneHref}>{SITE.phone}</a></p>
          <p class="text-muted">{c.formNote}</p>
        </div>
      </div>

      <div class="map-wrap">
        <iframe
          title={c.mapTitle}
          src={mapSrc}
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
        ></iframe>
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container contact-form-wrap">
      <ContactForm t={t} formName="contact-nl" actionHref="/contact/bedankt/" />
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2>{c.practiceNoteTitle}</h2>
      <p class="text-muted practice-note">{c.practiceNoteText}</p>
    </div>
  </section>
</Layout>

<style>
  .contact-grid {
    display: grid;
    gap: 2rem;
  }

  @media (min-width: 62em) {
    .contact-grid {
      grid-template-columns: 0.9fr 1.1fr;
      align-items: stretch;
    }
  }

  .contact-cards {
    display: grid;
    gap: 1.25rem;
  }

  .contact-card h2 {
    margin-top: 0;
    font-size: 1.2rem;
  }

  .contact-card .btn {
    margin-top: 0.75rem;
  }

  .contact-card-primary {
    border-color: var(--color-primary);
    border-width: 2px;
    box-shadow: var(--shadow-soft);
  }

  .contact-card-primary h2 {
    color: var(--color-primary-dark);
  }

  .contact-card-minor {
    padding-inline: 0.25rem;
  }

  .contact-card-minor h2 {
    margin: 0 0 0.4rem;
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--color-ink-muted);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .contact-card-minor p {
    font-size: 0.95rem;
  }

  .contact-card-minor a {
    color: var(--color-ink-muted);
  }

  .map-wrap {
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid var(--color-border);
    min-height: 20rem;
  }

  .map-wrap iframe {
    width: 100%;
    height: 100%;
    min-height: 20rem;
    border: 0;
  }

  .practice-note {
    max-width: 60ch;
  }

  .contact-form-wrap {
    max-width: 34rem;
  }
</style>
