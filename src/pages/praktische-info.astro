---
import Layout from '../layouts/Layout.astro';
import PageIntro from '../components/PageIntro.astro';
import CtaBanner from '../components/CtaBanner.astro';
import { getDictionary } from '../i18n';
import { SITE } from '../consts';

const t = getDictionary('nl');
const p = t.practical;

const sections = [
  { title: p.appointmentsTitle, text: p.appointmentsText },
  { title: p.prescriptionTitle, text: p.prescriptionText },
  { title: p.paymentTitle, text: [p.paymentText] },
  { title: p.cancelTitle, text: [p.cancelText] },
  { title: p.reachTitle, text: [p.reachText] },
];
---

<Layout
  locale="nl"
  t={t}
  title={p.metaTitle}
  description={p.metaDescription}
  breadcrumb={[{ label: t.nav.practical, href: '/praktische-info/' }]}
>
  <PageIntro eyebrow={p.eyebrow} title={p.title} intro={p.intro} />

  <section class="section">
    <div class="container">
      <div class="practical-list">
        <article class="practical-item card">
          <h2>{p.ratesTitle}</h2>
          <dl class="rates">
            {
              p.rates.map((rate) => (
                <div class="rate-row">
                  <dt>
                    {rate.label}
                    <span class="rate-duration">{rate.duration}</span>
                  </dt>
                  <dd>{rate.price}</dd>
                </div>
              ))
            }
          </dl>
          <p class="text-muted">{p.ratesNote}</p>
        </article>
        {
          sections.map((section) => (
            <article class="practical-item card">
              <h2>{section.title}</h2>
              {section.text.map((paragraph) => <p class="text-muted">{paragraph}</p>)}
            </article>
          ))
        }
      </div>
      <a class="btn btn-primary" href="/contact/">{t.cta.contact}</a>
    </div>
  </section>

  <CtaBanner
    title={t.home.ctaTitle}
    text={t.home.ctaText}
    ctaLabel={t.cta.contact}
    ctaHref="/contact/"
    secondaryLabel={t.cta.mailKim}
    secondaryHref={`mailto:${SITE.email}`}
  />
</Layout>

<style>
  .practical-list {
    display: grid;
    gap: 1.5rem;
    margin-bottom: 2.5rem;
  }

  .practical-item h2 {
    margin-top: 0;
    font-size: 1.2rem;
  }

  .practical-item p {
    margin: 0;
  }

  .practical-item p + p {
    margin-top: 0.75rem;
  }

  .rates {
    margin: 0 0 1rem;
    display: grid;
    gap: 0.75rem;
    max-width: 32rem;
  }

  .rate-row {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: baseline;
    gap: 1rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--color-border);
  }

  .rate-row dt {
    font-weight: 700;
  }

  .rate-duration {
    display: block;
    font-weight: 400;
    font-size: 0.92rem;
    color: var(--color-ink-muted);
  }

  .rate-row dd {
    margin: 0;
    font-weight: 700;
    white-space: nowrap;
  }
</style>
