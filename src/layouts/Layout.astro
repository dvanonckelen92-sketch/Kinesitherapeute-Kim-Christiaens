---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '@fontsource/atkinson-hyperlegible/400.css';
import '@fontsource/atkinson-hyperlegible/700.css';
import '@fontsource/atkinson-hyperlegible/400-italic.css';
import '@fontsource-variable/source-serif-4/standard.css';
import '../styles/global.css';
import type { Locale } from '../consts';
import { getDictionary, route as routeHref, type RouteKey } from '../i18n';
import { SITE } from '../consts';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  /** Sleutel van deze pagina in ROUTES; levert de hreflang-tags en de taalkeuze. Leeg op de 404. */
  route?: RouteKey;
  noindex?: boolean;
  /** Optional breadcrumb trail (excluding home), used for BreadcrumbList structured data. */
  breadcrumb?: { label: string; href: string }[];
}

const { locale, title, description, route, noindex = false, breadcrumb = [] } = Astro.props;
const t = getDictionary(locale);
const currentPath = Astro.url.pathname;
const canonicalURL = new URL(currentPath, Astro.site);
const nlURL = route ? new URL(routeHref(route, 'nl'), Astro.site) : undefined;
const frURL = route ? new URL(routeHref(route, 'fr'), Astro.site) : undefined;
const altHref = route ? routeHref(route, locale === 'nl' ? 'fr' : 'nl') : undefined;
const ogImageURL = new URL('/og-image.jpg', Astro.site);
const homeHref = routeHref('home', locale);

const siteRoot = new URL('/', Astro.site).toString();
const jsonLd: Record<string, unknown> = {
  '@context': 'https://schema.org',
  // MedicalBusiness met Physiotherapy als specialisme. "Physiotherapy" als @type wordt door
  // validators gelezen als de MedicalSpecialty-enumeratie, die geen properties mag hebben.
  '@type': 'MedicalBusiness',
  medicalSpecialty: 'https://schema.org/Physiotherapy',
  '@id': `${siteRoot}#organization`,
  name: SITE.brandFull,
  alternateName: [SITE.brandName, SITE.name],
  legalName: SITE.legalName,
  vatID: SITE.companyNumber,
  url: siteRoot,
  logo: {
    '@type': 'ImageObject',
    url: new URL('/icon-512.png', Astro.site).toString(),
    width: 512,
    height: 512,
  },
  image: ogImageURL.toString(),
  telephone: SITE.phone,
  email: SITE.email,
  priceRange: SITE.priceRange,
  currenciesAccepted: 'EUR',
  knowsLanguage: ['nl', 'fr'],
  sameAs: [SITE.instagramUrl],
  founder: {
    '@type': 'Person',
    name: 'Kim Christiaens',
    jobTitle: t.htmlLang.startsWith('fr') ? 'Kinésithérapeute' : 'Kinesitherapeute',
  },
  address: {
    '@type': 'PostalAddress',
    streetAddress: SITE.address.street,
    addressLocality: 'Heers',
    postalCode: '3870',
    addressRegion: 'Limburg',
    addressCountry: 'BE',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: SITE.coords.lat,
    longitude: SITE.coords.lon,
  },
  hasMap: `https://www.google.com/maps/search/?api=1&query=${SITE.coords.lat},${SITE.coords.lon}`,
  areaServed: t.areaServed.map((name) => ({ '@type': 'Place', name })),
};

// Sitenaam voor Google (naam in de zoekresultaten). Hoort enkel op de homepage van het domein.
const websiteLd =
  currentPath === '/'
    ? {
        '@context': 'https://schema.org',
        '@type': 'WebSite',
        '@id': `${siteRoot}#website`,
        name: SITE.brandName,
        alternateName: [SITE.brandFull, SITE.name],
        url: siteRoot,
        inLanguage: ['nl-BE', 'fr-BE'],
        publisher: { '@id': `${siteRoot}#organization` },
      }
    : undefined;

const breadcrumbLd =
  breadcrumb.length > 0
    ? {
        '@context': 'https://schema.org',
        '@type': 'BreadcrumbList',
        itemListElement: [{ label: t.nav.home, href: homeHref }, ...breadcrumb].map((item, index) => ({
          '@type': 'ListItem',
          position: index + 1,
          name: item.label,
          item: new URL(item.href, Astro.site).toString(),
        })),
      }
    : undefined;
---

<!doctype html>
<html lang={t.htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#ffffff" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow'} />
    <link rel="canonical" href={canonicalURL} />
    {nlURL && <link rel="alternate" hreflang="nl-BE" href={nlURL} />}
    {frURL && <link rel="alternate" hreflang="fr-BE" href={frURL} />}
    {nlURL && <link rel="alternate" hreflang="x-default" href={nlURL} />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.brandFull} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:locale" content={t.htmlLang.replace('-', '_')} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${SITE.brandFull} — ${t.home.heroTagline}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
    {websiteLd && <script type="application/ld+json" is:inline set:html={JSON.stringify(websiteLd)} />}
    {breadcrumbLd && <script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbLd)} />}
  </head>
  <body>
    <a class="skip-link" href="#main-content">{t.nav.skipToContent}</a>
    <Header locale={locale} t={t} currentPath={currentPath} altHref={altHref} />
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    <Footer locale={locale} t={t} />
  </body>
</html>
