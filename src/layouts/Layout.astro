---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '@fontsource/atkinson-hyperlegible/400.css';
import '@fontsource/atkinson-hyperlegible/700.css';
import '@fontsource/atkinson-hyperlegible/400-italic.css';
import '@fontsource-variable/source-serif-4/standard.css';
import '../styles/global.css';
import type { Locale } from '../consts';
import type { UiDictionary } from '../i18n/types';
import { SITE } from '../consts';

interface Props {
  locale: Locale;
  t: UiDictionary;
  title: string;
  description: string;
  /** FR/NL alternate for this exact page, or undefined when no direct translation exists yet. */
  altHref?: string;
  noindex?: boolean;
  /** Optional breadcrumb trail (excluding home), used for BreadcrumbList structured data. */
  breadcrumb?: { label: string; href: string }[];
}

const { locale, t, title, description, altHref, noindex = false, breadcrumb = [] } = Astro.props;
const currentPath = Astro.url.pathname;
const canonicalURL = new URL(currentPath, Astro.site);
const nlURL = altHref ? new URL(locale === 'nl' ? currentPath : altHref, Astro.site) : undefined;
const frURL = altHref ? new URL(locale === 'fr' ? currentPath : altHref, Astro.site) : undefined;
const ogImageURL = new URL('/og-image.jpg', Astro.site);
const homeHref = locale === 'nl' ? '/' : '/fr/';

const jsonLd: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': ['MedicalBusiness', 'PhysicalTherapy'],
  name: SITE.formalName,
  alternateName: SITE.brandFull,
  telephone: SITE.phone,
  email: SITE.email,
  sameAs: [SITE.instagramUrl],
  address: {
    '@type': 'PostalAddress',
    streetAddress: SITE.address.street,
    addressLocality: 'Heers',
    postalCode: '3870',
    addressCountry: 'BE',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: SITE.coords.lat,
    longitude: SITE.coords.lon,
  },
  areaServed: ['Heers', 'Sint-Truiden', 'Borgloon', 'Tongeren', 'Landen', 'Waremme'],
  url: canonicalURL.toString(),
};

const breadcrumbLd =
  breadcrumb.length > 0
    ? {
        '@context': 'https://schema.org',
        '@type': 'BreadcrumbList',
        itemListElement: [{ label: t.nav.home, href: homeHref }, ...breadcrumb].map((item, index) => ({
          '@type': 'ListItem',
          position: index + 1,
          name: item.label,
          item: new URL(item.href, Astro.site).toString(),
        })),
      }
    : undefined;
---

<!doctype html>
<html lang={t.htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/logo.png" />
    <link rel="apple-touch-icon" href="/logo.png" />
    <meta name="theme-color" content="#faf5ec" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow'} />
    <link rel="canonical" href={canonicalURL} />
    {nlURL && <link rel="alternate" hreflang="nl-BE" href={nlURL} />}
    {frURL && <link rel="alternate" hreflang="fr-BE" href={frURL} />}
    {nlURL && <link rel="alternate" hreflang="x-default" href={nlURL} />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.formalName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:locale" content={t.htmlLang.replace('-', '_')} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={SITE.formalName} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
    {breadcrumbLd && <script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbLd)} />}
  </head>
  <body>
    <a class="skip-link" href="#main-content">{t.nav.skipToContent}</a>
    <Header locale={locale} t={t} currentPath={currentPath} />
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    <Footer locale={locale} t={t} />
  </body>
</html>
