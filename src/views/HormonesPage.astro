---
import Layout from '../layouts/Layout.astro';
import PageIntro from '../components/PageIntro.astro';
import CtaBanner from '../components/CtaBanner.astro';
import LinkedText from '../components/LinkedText.astro';
import { getDictionary, route } from '../i18n';
import type { Locale } from '../consts';
import { SITE } from '../consts';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getDictionary(locale);
const h = t.hormones;
const breadcrumb = [{ label: t.nav.hormones, href: route('hormones', locale) }];
---

<Layout
  locale={locale}
  route="hormones"
  title={h.metaTitle}
  description={h.metaDescription}
  breadcrumb={breadcrumb}
>
  <PageIntro locale={locale} breadcrumb={breadcrumb} eyebrow={h.eyebrow} title={h.title} intro={h.intro} />

  <section class="section">
    <div class="container">
      <h2>{h.helpTitle}</h2>
      <ul class="check-list topic-list">
        {h.helpItems.map((item) => <li><LinkedText text={item} locale={locale} /></li>)}
      </ul>
    </div>
  </section>

  <section class="section section-alt" aria-labelledby="approach-heading">
    <div class="container">
      <h2 id="approach-heading">{h.approachTitle}</h2>
      <div class="approach-text">
        {h.approachText.map((paragraph) => <p>{paragraph}</p>)}
        <p class="text-muted"><LinkedText text={h.referralText} locale={locale} /></p>
      </div>
    </div>
  </section>

  <CtaBanner
    title={t.home.ctaTitle}
    text={t.home.ctaText}
    ctaLabel={t.cta.contact}
    ctaHref={route('contact', locale)}
    secondaryLabel={t.cta.mailKim}
    secondaryHref={`mailto:${SITE.email}`}
  />
</Layout>

<style>
  .topic-list {
    max-width: 46rem;
  }

  .approach-text {
    max-width: 62ch;
  }
</style>
