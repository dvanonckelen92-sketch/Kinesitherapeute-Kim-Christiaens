---
import Layout from '../layouts/Layout.astro';
import PageIntro from '../components/PageIntro.astro';
import ContactForm from '../components/ContactForm.astro';
import { getDictionary, route } from '../i18n';
import type { Locale } from '../consts';
import { SITE } from '../consts';
import InstagramIcon from '../components/InstagramIcon.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getDictionary(locale);
const c = t.contact;

const { lat, lon } = SITE.coords;
const bbox = `${lon - 0.008},${lat - 0.005},${lon + 0.008},${lat + 0.005}`;
const mapSrc = `https://www.openstreetmap.org/export/embed.html?bbox=${bbox}&layer=mapnik&marker=${lat},${lon}`;
const directionsHref = `https://www.google.com/maps/dir/?api=1&destination=${lat},${lon}`;
const breadcrumb = [{ label: t.nav.contact, href: route('contact', locale) }];
---

<Layout
  locale={locale}
  route="contact"
  title={c.metaTitle}
  description={c.metaDescription}
  breadcrumb={breadcrumb}
>
  <PageIntro locale={locale} breadcrumb={breadcrumb} eyebrow={c.eyebrow} title={c.title} intro={c.intro} />

  <section class="section">
    <div class="container contact-grid">
      <div class="card contact-card contact-card-primary">
        <h2>{c.detailsTitle}</h2>
        <address class="contact-details">
          <strong>{SITE.brandFull}</strong>
          <span>{SITE.address.street}<br />{SITE.address.postal}</span>
          <span>T <a href={SITE.phoneHref}>{SITE.phone}</a></span>
          <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
          <a href={route('home', locale)}>{SITE.website}</a>
          <a class="contact-instagram" href={SITE.instagramUrl} target="_blank" rel="noopener noreferrer">
            <InstagramIcon />
            <span>Instagram {SITE.instagram}</span>
          </a>
        </address>
        <div class="contact-actions">
          <a class="btn btn-primary" href={`mailto:${SITE.email}`}>{t.cta.email}</a>
          <a class="btn btn-primary" href={SITE.whatsappHref} target="_blank" rel="noopener noreferrer">{c.messageCta}</a>
          <a class="btn btn-secondary" href={directionsHref} rel="noopener">{c.mapTitle}</a>
        </div>
        <p class="text-muted contact-note">{c.formNote}</p>
      </div>

      <div class="map-wrap">
        <iframe
          title={c.mapTitle}
          src={mapSrc}
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
        ></iframe>
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container contact-form-wrap">
      <ContactForm locale={locale} />
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2>{c.practiceNoteTitle}</h2>
      <p class="text-muted practice-note">{c.practiceNoteText}</p>
    </div>
  </section>
</Layout>

<style>
  .contact-grid {
    display: grid;
    gap: 2rem;
  }

  @media (min-width: 62em) {
    .contact-grid {
      grid-template-columns: 0.9fr 1.1fr;
      align-items: stretch;
    }
  }

  .contact-card h2 {
    margin-top: 0;
    font-size: 1.2rem;
  }

  .contact-card-primary {
    border-color: var(--color-primary);
    border-width: 2px;
    box-shadow: var(--shadow-soft);
  }

  .contact-card-primary h2 {
    color: var(--color-primary-dark);
  }

  .contact-details {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    font-style: normal;
  }

  .contact-instagram {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    align-self: flex-start;
  }

  .contact-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }

  .contact-note {
    margin: 1rem 0 0;
    font-size: 0.95rem;
  }

  .map-wrap {
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid var(--color-border);
    min-height: 20rem;
  }

  .map-wrap iframe {
    width: 100%;
    height: 100%;
    min-height: 20rem;
    border: 0;
  }

  .practice-note {
    max-width: 60ch;
  }

  .contact-form-wrap {
    max-width: 34rem;
  }
</style>
